# cp env.sh.example env.sh，按自己的安装路径改。env.sh 不进版本库。
#
# 本仓库不提供 Vivado 的安装指导，只负责找到你已经装好的那一份。

# ------------------------------------------------------------------- Vivado

# 注意 2026.1 的目录布局是**版本在前**（早期版本是工具在前）：
#     2026.1       /tools/Xilinx/2026.1/Vivado/settings64.sh
#     2024.2 及更早 /tools/Xilinx/Vivado/2024.2/settings64.sh

# 最常见的写法：source 官方的 settings64.sh
# source /tools/Xilinx/2026.1/Vivado/settings64.sh

# 或者直接把 bin 目录加进 PATH
# export PATH=/tools/Xilinx/2026.1/Vivado/bin:$PATH

# 判定需要四个命令：
#   xvlog    L1 分析
#   xelab    L1 详细描述
#   xsim     L2 仿真
#   vivado   L3 综合（synth_design）
#
# 全部来自 Vivado 安装，不需要 Vitis。不会退回 iverilog / Verilator——赛事方
# 全流程只用 AMD 工具链，本地用别的仿真器会得到不一致的判定。

# ------------------------------------------------------------------ 授权

# **2026.1 的 xsim 与 synth_design 都需要授权席位**，不配就只能判到 L1。
# xvlog / xelab 不需要，所以"能编译但仿真结果永远出不来"正是缺席位的典型症状。
# 2024.2 及更早在 ZU3EG 上是免授权的，所以老教程里没有这一节。
# export XILINXD_LICENSE_FILE=2100@your-license-server

# 席位签不出时**没有报错**：xsim 照常退出 0，日志里也没有 "license" 字样，
# 只是那行 "Mismatches: N in M samples" 不见了。判定器会把这种情况判成
# LICENSE_ERROR 而不是算你代码的错（见 selftest/judge/来源.md）。
#
# 另有一种情况：席位有，但档位不覆盖你指定的器件。报错长得像器件名拼错
# （ERROR: [Coretcl 2-106] Specified part could not be found），判定器
# 会区分开，报 PART_NOT_LICENSED。

# ------------------------------------------------------------------ LLM 后端

# 桩模式：不联网、不要 key，只验证链路
export LLM_BACKEND=mock

# 开发调试：任意 OpenAI 兼容的商用 API
# export LLM_BACKEND=openai
# export LLM_BASE_URL=https://api.deepseek.com/v1
# export LLM_API_KEY=sk-xxxxxxxx
# export LLM_MODEL=deepseek-coder

# 正式提交必须是这一种：本地部署的开源权重
# export LLM_BACKEND=openai
# export LLM_BASE_URL=http://localhost:8000/v1
# export LLM_API_KEY=dummy
# export LLM_MODEL=Qwen3-8B

# -------------------------------------------------------------------- 其它

# 临时目录，必须是本地盘。指向 NFS 时综合会慢一个数量级
# export AGENT_TMP=/tmp
# export SELFTEST_TMP=/tmp

# 保留判定的工作目录，排查问题时用
# export SELFTEST_KEEP_WORK=1

# 综合器件，与赛事方一致，一般不需要改
# export RTL_PART=xczu3eg-sbva484-1-e

# 增益项满分线，占位值，以赛前公告为准
# export GAIN_FULL_MARK=2.5
